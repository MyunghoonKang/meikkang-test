# ===== 3A (Plan A — 서버 · DB · 게임) =====
PORT=3000
DB_PATH=./data/app.db
GAMES_DIR=./games

# ===== 4A · 4B (Plan B — ERP 자동화 · Vault) =====
# 32-byte hex key. 생성: openssl rand -hex 32
VAULT_MASTER_KEY=
# mock | dryrun | live  (데모는 mock, 리허설은 dryrun, 실 ERP 만 live)
WORKER_MODE=mock
ERP_BASE_URL=https://erp.meissa.ai
ERP_COMPANY_CODE=meissa
# 실 상신 토글. WORKER_MODE=live 와 이 값이 동시에 1 일 때만 [상신] 클릭. 평상시 주석 유지.
# ERP_CONFIRM_SUBMIT=0
